---
import BaseHead from '../components/layout/BaseHead.astro';
import FetchError from '../components/FetchError.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageLayout from '../components/layout/PageLayout.astro';
import Comments from '../components/comments/Comments.astro';
import MoveToDraftButton from '../components/posts/MoveToDraftButton.astro';
import PageTitle from '../components/layout/PageTitle.astro';
import Link from '../components/ui/Link.astro';
import PostContents from '../components/posts/PostContents.astro';

interface Props {
	title: string;
	createdAt?: Date;
	publishedAt?: Date;
	updatedAt?: Date;
	thumbnailUrl?: string | null;
	content?: string;
	errorMessage?: string;
	postId?: string;
	isLoggedIn?: boolean;
	isAuthor?: boolean;
	previewOf?: string;
}

const { title, createdAt, publishedAt, updatedAt, thumbnailUrl, content, errorMessage, postId, isLoggedIn = false, isAuthor = false, previewOf } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-panel);
				box-shadow: var(--shadow-page);
			}
			.media-viewer img {
				display: block;
				object-fit: contain;
			}
			.media-viewer img[data-loading] {
				width: min(20rem, calc(100vw - 2rem));
				height: min(20rem, calc(100dvh - 2rem));
				background: var(--color-surface);
			}
			:global(#post-content img:not(a img)) {
				cursor: zoom-in;
			}
			.post-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
		</style>
	</head>

	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			<PostContents slot="left-sidebar" target="post-content" />
			{errorMessage ? (
				<div><FetchError message={errorMessage} /></div>
			) : (
			<article>
				<div class="hero-image">
					{thumbnailUrl && <img width="1020" height="510" src={thumbnailUrl} alt="" />}
				</div>
				<div>
					<div class="post-header">
						<PageTitle title={title} className="post-title title-wave" />
						<div class="post-meta">
							{createdAt && <div class="post-metadata">Created on <FormattedDate date={createdAt} includeTime /></div>}
							{publishedAt && <div class="post-metadata">Published on <FormattedDate date={publishedAt} includeTime /></div>}
							{updatedAt && <div class="post-metadata">Last updated on <FormattedDate date={updatedAt} includeTime /></div>}
							{previewOf ? (
								<div class="post-actions">
									<Link class="ui-button" href={`/posts/edit/${previewOf}/`}>back to editor</Link>
								</div>
							) : isAuthor && postId && (
								<div class="post-actions">
									<Link class="ui-button" href={`/posts/edit/${postId}/`}>edit</Link>
									<MoveToDraftButton postId={postId} />
								</div>
							)}
						</div>
						<hr />
					</div>
					{content && <div id="post-content" class="markdown-content" set:html={content} />}
					{content && <dialog class="media-viewer" data-post-image-viewer aria-label="full-size image"><img alt="" /></dialog>}
					{postId && !previewOf && <Comments postId={postId} />}
				</div>
			</article>
			)}
		</PageLayout>
	<script>
	import { bindPage } from '../scripts/bind-page';

	// Opens post images, including gallery slides, in a full-size viewer.
	bindPage('#post-content', (content) => {
		const viewer = document.querySelector<HTMLDialogElement>('[data-post-image-viewer]');
		const viewerImage = viewer?.querySelector('img');
		if (!viewer || !viewerImage) return;

		content.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof HTMLImageElement) || target.closest('a')) return;
			// Browsers keep painting the previous image until a new src loads, so drop it first.
			viewerImage.removeAttribute('src');
			viewerImage.alt = target.alt;
			viewerImage.dataset.loading = '';
			viewerImage.src = target.currentSrc || target.src;
			viewer.showModal();
		});
		// Esc doubles as the browser's "stop loading" key, which would abort post images still downloading.
		viewer.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return;
			event.preventDefault();
			viewer.close();
		});
		const finishLoading = () => delete viewerImage.dataset.loading;
		viewerImage.addEventListener('load', finishLoading);
		viewerImage.addEventListener('error', finishLoading);
		viewer.addEventListener('click', (event) => {
			if (event.target === viewer || event.target === viewerImage) viewer.close();
		});
	});

	// Binds prev/next navigation for in-post galleries.
	bindPage('[data-gallery]', (gallery) => {
		const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery__item'));
		if (slides.length < 2) return;

		const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
		const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
		const currentLabel = gallery.querySelector<HTMLElement>('[data-gallery-current]');

		let index = 0;
		const show = (nextIndex: number) => {
			index = (nextIndex + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				slide.hidden = i !== index;
				if (slide.hidden) slide.querySelector('video')?.pause();
			});
				if (currentLabel) currentLabel.textContent = String(index + 1);
			};

			prev?.addEventListener('click', () => show(index - 1));
			next?.addEventListener('click', () => show(index + 1));
	});
	</script>
	</body>
</html>
