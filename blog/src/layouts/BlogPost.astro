---
import BaseHead from '../components/layout/BaseHead.astro';
import FetchError from '../components/FetchError.astro';
import FormattedDate from '../components/FormattedDate.astro';
import PageLayout from '../components/layout/PageLayout.astro';
import Comments from '../components/comments/Comments.astro';
import MoveToDraftButton from '../components/posts/MoveToDraftButton.astro';
import PageTitle from '../components/layout/PageTitle.astro';
import Link from '../components/ui/Link.astro';
import PostContents from '../components/posts/PostContents.astro';

interface Props {
	title: string;
	createdAt?: Date;
	publishedAt?: Date;
	updatedAt?: Date;
	thumbnailUrl?: string | null;
	content?: string;
	errorMessage?: string;
	postId?: string;
	isLoggedIn?: boolean;
	isAuthor?: boolean;
}

const { title, createdAt, publishedAt, updatedAt, thumbnailUrl, content, errorMessage, postId, isLoggedIn = false, isAuthor = false } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={title} />
		<style>
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: var(--radius-panel);
				box-shadow: var(--shadow-page);
			}
			.post-actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
			}
		</style>
	</head>

	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			<PostContents slot="right-sidebar" target="post-content" />
			{errorMessage ? (
				<div><FetchError message={errorMessage} /></div>
			) : (
			<article>
				<div class="hero-image">
					{thumbnailUrl && <img width="1020" height="510" src={thumbnailUrl} alt="" />}
				</div>
				<div>
					<div class="post-header">
						<PageTitle title={title} className="post-title title-wave" />
						<div class="post-meta">
							{createdAt && <div class="post-metadata">Created on <FormattedDate date={createdAt} includeTime /></div>}
							{publishedAt && <div class="post-metadata">Published on <FormattedDate date={publishedAt} includeTime /></div>}
							{updatedAt && <div class="post-metadata">Last updated on <FormattedDate date={updatedAt} includeTime /></div>}
							{isAuthor && postId && (
								<div class="post-actions">
									<Link class="ui-button" href={`/posts/edit/${postId}/`}>edit</Link>
									<MoveToDraftButton postId={postId} />
								</div>
							)}
						</div>
						<hr />
					</div>
					{content && <div id="post-content" class="markdown-content" set:html={content} />}
					{postId && <Comments postId={postId} />}
				</div>
			</article>
			)}
		</PageLayout>
	<script>
	import { bindPage } from '../scripts/bind-page';

	// Binds prev/next navigation for in-post galleries.
	bindPage('[data-gallery]', (gallery) => {
		const slides = Array.from(gallery.querySelectorAll<HTMLElement>('.gallery__item'));
		if (slides.length < 2) return;

		const prev = gallery.querySelector<HTMLButtonElement>('[data-gallery-prev]');
		const next = gallery.querySelector<HTMLButtonElement>('[data-gallery-next]');
		const currentLabel = gallery.querySelector<HTMLElement>('[data-gallery-current]');

		let index = 0;
		const show = (nextIndex: number) => {
			index = (nextIndex + slides.length) % slides.length;
			slides.forEach((slide, i) => {
				slide.hidden = i !== index;
			});
				if (currentLabel) currentLabel.textContent = String(index + 1);
			};

			prev?.addEventListener('click', () => show(index - 1));
			next?.addEventListener('click', () => show(index + 1));
	});
	</script>
	</body>
</html>
