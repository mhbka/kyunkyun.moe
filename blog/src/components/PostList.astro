---
import type { DraftPostSummary, PostSummary } from '../lib/models/posts.ts';
import FormattedDate from './FormattedDate.astro';
import MoveToDraftButton from './MoveToDraftButton.astro';
import Button from './ui/Button.astro';
import Link from './ui/Link.astro';
import EdgeCard from './ui/EdgeCard.astro';

interface Props {
	posts: Array<PostSummary | DraftPostSummary>;
	variant: 'published' | 'drafts';
	isAuthor?: boolean;
	cards?: boolean;
}

const { posts, variant, isAuthor = false, cards = false } = Astro.props;
// Keeps list semantics while optionally giving each post its own edge card.
const Item = cards ? EdgeCard : 'li';
---

<ul
	class:list={['post-list', { 'post-list--cards': cards }]}
	id={variant === 'drafts' ? 'draft-list' : 'published-list'}
>
	{posts.map((post) => (
		<Item as={cards ? 'li' : undefined} data-draft-id={variant === 'drafts' ? post.id : undefined}>
			<Link class="post-card" href={variant === 'drafts' ? `/posts/edit/${post.id}/` : `/blog/${post.slug}/`}>
				{post.thumbnailUrl && <img width="720" height="360" src={post.thumbnailUrl} alt="" />}
				<h4 class="post-card__title">{post.title}</h4>
				<p class="post-card__date">
					{variant === 'drafts'
						? <>Updated <FormattedDate date={new Date((post as DraftPostSummary).updatedAt)} /></>
						: <FormattedDate date={new Date((post as PostSummary).publishedAt)} />}
				</p>
				{post.tags.length > 0 && <p class="post-card__tags">{post.tags.map((tag) => `#${tag}`).join(' ')}</p>}
			</Link>
			{isAuthor && variant === 'published' && (
				<div class="post-list__actions">
					<Link class="ui-button" href={`/posts/edit/${post.id}/`}>edit</Link>
					<MoveToDraftButton postId={post.id} />
				</div>
			)}
			{variant === 'drafts' && (
				<div class="post-list__actions">
					<Link class="ui-button" href={`/posts/edit/${post.id}/`}>edit</Link>
					<Button type="button" data-publish-id={post.id}>publish</Button>
					<Button type="button" data-delete-id={post.id} data-delete-title={post.title}>delete</Button>
				</div>
			)}
		</Item>
	))}
</ul>

<style>
	:global(.post-list) { display: grid; gap: 2rem; margin: 0; padding: 0; list-style: none; }
	:global(.post-list > li) { width: 100%; text-align: left; }
	:global(.post-list.post-list--cards) { gap: 0.5rem; }
	:global(.post-card) { display: block; text-decoration: none; }
	:global(.post-card img) { display: block; width: 100%; margin-bottom: 0.5rem; border-radius: var(--radius-panel); transition: box-shadow 0.2s ease; }
	:global(.post-card__title) { margin: 0; color: var(--color-heading); line-height: 1; transition: color 0.2s ease; }
	:global(.post-card__date) { margin: 0.5rem 0; color: var(--color-muted); transition: color 0.2s ease; }
	:global(.post-card__tags) { margin: -0.25rem 0 0; color: var(--color-muted); transition: color 0.2s ease; }
	:global(.post-card:hover .post-card__title), :global(.post-card:hover .post-card__date), :global(.post-card:hover .post-card__tags) { color: var(--color-accent); }
	:global(.post-card:hover img) { box-shadow: var(--shadow-page); }
	:global(.post-list__actions) { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.75rem; }
	@media (max-width: 720px) { :global(.post-list) { gap: 0.5rem; } }
</style>
