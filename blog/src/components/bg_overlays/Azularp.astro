---
// Renders the Azumanga Daioh character group behind the main content cards.
---

<img class="background-overlay background-overlay--azularp" src="/images/bg_overlays/azularp.webp" alt="" />

<style>
	/* Extends Azularp behind the content and into the navigation fade. */
	.background-overlay--azularp {
		position: absolute;
		inset: auto 2vw 0 auto;
		display: block;
		width: 73vw;
		height: 98dvh;
		object-fit: contain;
		object-position: right bottom;
		opacity: 0.92;
	}
</style>
