---
// Renders Frieren artwork behind the main content cards.
---

<img class="background-overlay background-overlay--frieren" src="/images/bg_overlays/frierenlarp.webp" alt="" />

<style>
	/* Anchors the character artwork large beyond the lower-right edge. */
	.background-overlay--frieren {
		position: absolute;
		inset: auto 2vw -3dvh auto;
		display: block;
		width: 76vw;
		height: 105dvh;
		object-fit: contain;
		object-position: right bottom;
		opacity: 0.93;
	}
</style>
