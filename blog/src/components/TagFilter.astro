---
import { toggleTagUrl } from '../lib/tags.ts';
import Link from './ui/Link.astro';
import type { TagSummary } from '../lib/models/tags.ts';

interface Props {
	tags: TagSummary[];
	selectedTags: string[];
	basePath?: string;
}

const { tags, selectedTags, basePath = '/blog/' } = Astro.props;
---

{tags.length > 0 && (
	<nav class="tag-filter" aria-label="Filter posts by tag" data-tag-filter data-client-filter={basePath === '/blog/' ? 'true' : 'false'}>
		<Link class:list={['tag-filter__tag', !selectedTags.length && 'tag-filter__tag--selected']} href={basePath} data-tag="">all</Link>
		{tags.map(({ tag, count }) => (
			<Link class:list={['tag-filter__tag', selectedTags.includes(tag) && 'tag-filter__tag--selected']} href={toggleTagUrl(basePath, selectedTags, tag)} data-tag={tag} aria-current={selectedTags.includes(tag) ? "true" : undefined}>
				#{tag} <span aria-label={`${count} posts`}>({count})</span>
			</Link>
		))}
	</nav>
)}

<script>
	import { readTagFilters, toggleTagUrl } from '../lib/tags.ts';
	const filter = document.querySelector<HTMLElement>('[data-tag-filter]');

	function currentTag() {
		return readTagFilters(new URL(window.location.href).searchParams);
	}

	function updateSelection(tags: string[]) {
		filter?.querySelectorAll<HTMLAnchorElement>('[data-tag]').forEach((link) => {
			link.classList.toggle('tag-filter__tag--selected', link.dataset.tag ? tags.includes(link.dataset.tag) : tags.length === 0);
			link.href = toggleTagUrl(window.location.pathname, tags, link.dataset.tag ?? '');
			if (link.dataset.tag && tags.includes(link.dataset.tag)) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		});
	}

	function filterPosts(tags: string[]) {
		updateSelection(tags);
		document.dispatchEvent(new CustomEvent('posts:filter', { detail: tags }));
	}

	filter?.addEventListener('click', (event) => {
		if (filter.dataset.clientFilter !== 'true') return;
		const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('[data-tag]');
		if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;

		event.preventDefault();
		const url = new URL(link.href);
		window.history.pushState(null, '', url);
		filterPosts(readTagFilters(url.searchParams));
	});

	window.addEventListener('popstate', () => filterPosts(currentTag()));
</script>

<style>
	.tag-filter { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 1rem; }
	.tag-filter__tag { color: var(--color-muted); text-decoration: none; }
	.tag-filter__tag--selected { color: var(--color-accent); text-decoration: underline; }
</style>
