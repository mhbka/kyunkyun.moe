---
import NanamiHanging from './NanamiHanging.astro';

// Keeps the decorative background mounted across client-side page navigations.
const persistentBackgroundTransition = {
	forwards: {
		old: { name: 'none' },
		new: { name: 'none' },
	},
	backwards: {
		old: { name: 'none' },
		new: { name: 'none' },
	},
};
---

<div
	class="site-background"
	aria-hidden="true"
	transition:name="site-background"
	transition:persist="site-background"
	transition:animate={persistentBackgroundTransition}
>
</div>

<!-- Keeps the animated decoration above page content across navigations. -->
<div
	class="site-foreground__hangingout"
	aria-hidden="true"
	transition:name="site-foreground-hangingout"
	transition:persist="site-foreground-hangingout"
	transition:animate={persistentBackgroundTransition}
>
	<NanamiHanging />
</div>
