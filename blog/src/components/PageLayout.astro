---
import Footer from './Footer.astro';
import Background from './Background.astro';
import Changelog from './Changelog.astro';
import Header from './Header.astro';
import PageTop from './PageTop.astro';
import PageTitle from './PageTitle.astro';
import Walker from './Walker.astro';

interface Props {
	isLoggedIn?: boolean;
	mainClass?: string;
	renderChangelog?: boolean;
	renderQuote?: boolean;
	renderWalker?: boolean;
	title?: string;
	titleClass?: string;
}

const { isLoggedIn = false, mainClass, renderChangelog = false, renderQuote = true, renderWalker = true, title, titleClass } = Astro.props;

// Keeps persistent UI visible in both transition snapshots without animating either one.
const persistentUiTransition = {
	forwards: {
		old: { name: 'none' },
		new: { name: 'none' },
	},
	backwards: {
		old: { name: 'none' },
		new: { name: 'none' },
	},
};
---

<Background />
<div class="site-layout">
	<div class="site-sidebar">
		<!-- Keeps the stable site navigation outside page transition effects. -->
		<div class="site-header-persist" transition:persist="site-header" transition:animate={persistentUiTransition}>
			<Header isLoggedIn={isLoggedIn} />
		</div>
		{renderChangelog && <Changelog />}
	</div>
	<div class="page-content">
		<PageTop><slot name="page-top" /></PageTop>
		<main class:list={['page-main', mainClass]}>
			{title && (
				<header class="page-heading">
					<PageTitle title={title} className={titleClass} />
					<hr />
				</header>
			)}
			<div class="page-body">
				<slot />
			</div>
			<hr />
		</main>
		<Footer renderQuote={renderQuote} />
	</div>
	{Astro.slots.has('right-sidebar') && (
		<aside class="site-sidebar site-sidebar-right" aria-label="page navigation">
			<slot name="right-sidebar" />
		</aside>
	)}
</div>
{renderWalker && <Walker />}
