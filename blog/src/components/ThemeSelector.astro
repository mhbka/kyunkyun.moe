---
import { DEFAULT_THEME_ID, THEMES } from '../consts';
import Select from './ui/Select.astro';
---

<Select fullWidth data-theme-selector aria-label="Theme">
	{THEMES.map((theme) => <option value={theme.id}>{theme.label}</option>)}
	<option disabled>more themes soon</option>
</Select>

<script is:inline define:vars={{ defaultThemeId: DEFAULT_THEME_ID, themeIds: THEMES.map((theme) => theme.id) }}>
	const themeSelector = document.querySelector('[data-theme-selector]');
	const themeStorageKey = 'site-theme';
	const savedTheme = localStorage.getItem(themeStorageKey);
	const activeTheme = themeIds.includes(savedTheme) ? savedTheme : defaultThemeId;

	document.documentElement.dataset.theme = activeTheme;
	if (themeSelector instanceof HTMLSelectElement) {
		themeSelector.value = activeTheme;
		themeSelector.addEventListener('change', () => {
			document.documentElement.dataset.theme = themeSelector.value;
			localStorage.setItem(themeStorageKey, themeSelector.value);
		});
	}
</script>
