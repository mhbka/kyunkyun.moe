---
import Button from './ui/Button.astro';

interface Props {
	postId: string;
}

const { postId } = Astro.props;
---

<Button type="button" data-move-to-draft-id={postId}>move to draft</Button>

<script>
	import { blogApi } from '../lib/api.ts';
	import { createSupabaseBrowserClient } from '../lib/auth/supabase.ts';

	import { navigate } from 'astro:transitions/client';
	import { bindPage } from '../scripts/bind-page';

	bindPage<HTMLButtonElement>('[data-move-to-draft-id]', (button) => {
		button.addEventListener('click', async () => {
			const postId = button.dataset.moveToDraftId;
			if (!postId) return;

			button.disabled = true;
			try {
				const { data: { session } } = await createSupabaseBrowserClient().auth.getSession();
				if (!session) throw new Error('Your session has expired. Please sign in again.');
				await blogApi.movePostToDraft(postId, session.access_token);
				await navigate(`/posts/edit/${encodeURIComponent(postId)}/`);
			} catch (error) {
				window.alert(error instanceof Error ? error.message : 'Unable to move this post to drafts.');
				button.disabled = false;
			}
		});
	});
</script>
