---
import Input from './ui/Input.astro';
import Button from './ui/Button.astro';

interface Props {
	id: string;
	name: string;
	label: string;
	initialTags?: string[];
	list?: string;
}

const { id, name, label, initialTags = [], list } = Astro.props;
---

<div class="tag-input" data-tag-input>
	<ul class="tag-list" data-tag-list aria-label={label}></ul>
	<Input id={id} placeholder={label} autocomplete="off" aria-label={label} list={list} />
	<input type="hidden" name={name} data-tag-value value={JSON.stringify(initialTags)} />
	<template><li><Button class="tag" type="button" /></li></template>
</div>

<script>
	import { initTagInput } from './tag-input.ts';
	// Initializes shared tag controls on normal loads and client-side navigation.
	function bindTagInputs() {
		document.querySelectorAll<HTMLElement>('[data-tag-input]').forEach(initTagInput);
	}
	bindTagInputs();
	document.addEventListener('astro:page-load', bindTagInputs);
</script>

<style>
	.tag-input { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; padding: .4rem; }
	.tag-input:focus-within { border-radius: var(--radius-focus); box-shadow: 0 0 0 var(--focus-ring-width) var(--color-accent); }
	/* Allows the tag field to fit within very narrow upload layouts. */
	.tag-input :global(.ui-input) { min-width: min(12rem, 100%); max-width: 100%; flex: 1; padding: .3rem; border: 0; outline: 0; background: var(--color-transparent); }
	.tag-input :global(.ui-input)::placeholder { color: var(--color-muted); opacity: 1; }
	.tag-list { display: flex; flex-wrap: wrap; gap: .4rem; margin: 0; padding: 0; list-style: none; }
	.tag-list :global(.tag) { padding: .2rem .55rem; border-radius: var(--radius-tag); background: var(--color-subtle); color: var(--color-text); font-size: .8rem; }
</style>
