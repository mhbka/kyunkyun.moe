---
import { renderMarkdown } from '../../lib/content/markdown.ts';

interface Props {
	label: string;
	markdown: string;
}

const { label, markdown } = Astro.props;
const renderedContent = await renderMarkdown(markdown);
const content = renderedContent
	.replace(/<pre[^>]*>/g, '<pre class="mini-code-block">')
	.replace(/<code[^>]*>/g, '<code>');
---

<section class="scrolling-markdown" aria-label={label}>
	<div set:html={content} />
</section>

<style>
	/* Keeps long supporting documents compact inside their independent cards. */
	.scrolling-markdown { max-height: 16rem; overflow-y: auto; overscroll-behavior: contain; }
	.scrolling-markdown :global(h1) { margin: 0 0 0.75rem; color: var(--color-text); font: inherit; font-weight: 700; }
	.scrolling-markdown :global(h2) { margin: 1rem 0 0.5rem; color: var(--color-text); font: inherit; font-weight: 400; }
	@media (max-width: 800px) {
		.scrolling-markdown { max-height: 10rem; }
		.scrolling-markdown :global(h1) { margin-bottom: 0.5rem; }
		.scrolling-markdown :global(h2) { margin: 0.75rem 0 0.35rem; }
	}
</style>
