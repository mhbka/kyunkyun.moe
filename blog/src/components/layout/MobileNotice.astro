<script>
	import { markMobileNoticeShown, shouldShowMobileNotice } from '../../lib/utils/mobile-notice.ts';

	// Shows the one-time notice only when the current viewport uses the mobile layout.
	function showMobileNotice() {
		if (!window.matchMedia('(max-width: 800px)').matches) return;
		try {
			if (!shouldShowMobileNotice(localStorage)) return;
			markMobileNoticeShown(localStorage);
			window.alert('this website is desktop-first. you will miss out a few things on mobile :p');
		} catch {
			// Skips the optional notice when browser storage is unavailable.
			return;
		}
	}

	showMobileNotice();
	document.addEventListener('astro:page-load', showMobileNotice);
</script>
