---
import Background from '../ambient/Background.astro';
import Header from './Header.astro';
import MobileNotice from './MobileNotice.astro';
import PageTop from './PageTop.astro';
import Walker from '../walker/Walker.astro';
import EdgeCard from '../ui/EdgeCard.astro';

interface Props {
	isLoggedIn?: boolean;
	mainClass?: string;
	separateCards?: boolean;
	renderWalker?: boolean;
	title?: string;
}

const { isLoggedIn = false, mainClass, separateCards = false, renderWalker = true, title } = Astro.props;
// Lets pages compose several cards without adding an enclosing card surface.
const Content = separateCards ? 'div' : EdgeCard;

---

<Background />
<MobileNotice />
<div class="site-layout">
	<Header isLoggedIn={isLoggedIn} />
	<div class="site-content-region">
		<!-- Anchors side cards to the main card's left edge whatever its width. -->
		<div class="page-primary">
			{Astro.slots.has('left-sidebar') && (
				<aside class="site-sidebar site-sidebar-left" aria-label="page navigation">
					<div class="site-sidebar-stick">
						<slot name="left-sidebar" />
					</div>
				</aside>
			)}
			<Content as="div" class:list={['page-content', { 'page-content--cards': separateCards }]}>
				<PageTop><slot name="page-top" /></PageTop>
				<!-- Keeps the page landmark named without repeating the navigation label visually. -->
				<main class:list={['page-main', mainClass]} aria-label={title}>
					<div class="page-body">
						<slot />
					</div>
				</main>
			</Content>
		</div>
		<!-- Allows pages to add independent cards beneath their primary content. -->
		<slot name="cards" />
	</div>
</div>
{renderWalker && <Walker />}
