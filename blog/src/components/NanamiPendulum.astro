---
// Mounts the interactive SD002 pendulum with the blog's existing exported assets.
---

<svg
	class="site-foreground__pendulum"
	aria-hidden="true"
	data-json-url="/images/nanami_hanging/sd002.json"
	data-image-directory-url="/images/nanami_hanging/sd002/"
	data-image-prefix="SD002"
></svg>

<script is:inline type="module">
	import { mountPendulum } from '/simplemotion/pendulum-embed.js';

	// Reconnects the SVG if a client-side navigation supplied a fresh element.
	function mountCurrentPendulum() {
		const svg = document.querySelector('.site-foreground__pendulum');
		if (!(svg instanceof SVGSVGElement) || svg.dataset.mounted) return;

		svg.dataset.mounted = 'true';
		void mountPendulum(svg, {
			jsonUrl: svg.dataset.jsonUrl,
			imageDirectoryUrl: svg.dataset.imageDirectoryUrl,
			imagePrefix: svg.dataset.imagePrefix,
		})
			// Reports decoration failures without blocking the page content.
			.catch((error) => console.warn('Could not load the hanging animation.', error))
			// Reveals the page after the first frame, including when assets fail.
			.finally(() => requestAnimationFrame(() => window.dispatchEvent(new Event('nanami-pendulum-ready'))));
	}

	mountCurrentPendulum();
	document.addEventListener('astro:page-load', mountCurrentPendulum);
</script>
