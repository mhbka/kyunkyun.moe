---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description?: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<!-- Starts the pendulum's image downloads before its client-side renderer mounts. -->
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-bg.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-おちる….png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-たすけっ….png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-たすけっ…as1.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-たすけっ…as2.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-スマホ.png32.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-七海体.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-七海体ef1.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-七海体ef12.png" />
<link rel="preload" as="image" href="/images/nanami_hanging/sd002/SD002-七海体ef13.png" />

<script is:inline>
	// Keeps the first desktop render hidden until the pendulum has drawn its first frame.
	if (window.matchMedia('(min-width: 801px) and (prefers-reduced-motion: no-preference)').matches) {
		document.documentElement.classList.add('pendulum-loading');
		const revealPage = () => document.documentElement.classList.remove('pendulum-loading');
		window.addEventListener('nanami-pendulum-ready', revealPage, { once: true });
		window.setTimeout(revealPage, 5000);
	}
</script>
<ClientRouter />

<script>
	import { bindNavigationFade } from '../scripts/navigation-fade';

	bindNavigationFade();

	// Freezes the animated walker before the browser captures its transition snapshot.
	document.addEventListener('astro:before-preparation', (event) => {
		window.dispatchEvent(new Event('walkerpause'));
		event.signal.addEventListener('abort', () => window.dispatchEvent(new Event('walkerresume')), { once: true });
	});

	// Restores the walker's movement only after the browser returns to the live DOM.
	document.addEventListener('astro:before-swap', (event) => {
		const resumeWalker = () => window.dispatchEvent(new Event('walkerresume'));
		void event.viewTransition.finished.then(resumeWalker, resumeWalker);
	});
</script>

<script is:inline>
	// Warn before leaving an editor with unsaved changes through an internal link.
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Element)) return;
		const link = event.target.closest('a[href]');
		const editor = document.querySelector<HTMLElement>('[data-post-editor][data-dirty="true"]');
		if (!link || !editor || event.defaultPrevented || link.target || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		if (!window.confirm('You have unsaved changes. Leave this page?')) event.preventDefault();
	}, true);

	// Warn before a browser refresh closes a dirty editor.
	window.addEventListener('beforeunload', (event) => {
		if (!document.querySelector('[data-post-editor][data-dirty="true"]')) return;
		event.preventDefault();
	});
</script>

<Font cssVariable="--font-m-plus-1p" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{`${title} ~ ${SITE_TITLE}`}</title>
<meta name="description" content={description ?? SITE_DESCRIPTION} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{image && <meta property="og:image" content={new URL(image.src, Astro.url)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
