---
import MainNavItem from './ui/MainNavItem.astro';
import AmbientSakura from './AmbientSakura.astro';
import LoginButton from './LoginButton.astro';
import WalkerSelector from './WalkerSelector.astro';
import Footer from './Footer.astro';
import { SITE_TITLE } from '../consts';
import '../styles/base/site-navigation.css';

interface Props {
	isLoggedIn?: boolean;
}

const { isLoggedIn = false } = Astro.props;
const isNonsenseActive = Astro.url.pathname.startsWith('/nonsense/');
const logoParts = [
	{ text: '(', position: 'opening' },
	{ text: '\u304d', position: 'start' },
	{ text: '\u3085', position: 'crest' },
	{ text: '\u3093', position: 'end' },
	{ text: ')', position: 'closing' },
	{ text: '\u3005', position: 'repeater' },
	{ text: '.moe', position: 'suffix' },
];
---

<!-- Keeps the global navigation independent of sidebar panels. -->
<div class="site-header">
	<!-- Lets petals drift down from the pink wash at the top of the navigation. -->
	<AmbientSakura />
	<!-- Uses a wordmark until the final logo artwork is ready. -->
	<div class="site-logo" role="img" aria-label={`${SITE_TITLE} logo`}>
		<span class="site-logo__bubble" aria-hidden="true"></span>
		<!-- Overlays the image-filled wordmark on its outlined shadow layer. -->
		<span class="site-logo__layers" aria-hidden="true">
			{
				['shadow', 'outline', 'fill'].map((layer) => (
					<span class={`site-logo__layer site-logo__${layer}`}>
						{logoParts.map((part) => (
							<span class={`site-logo__part site-logo__part--${part.position}`}>{part.text}</span>
						))}
					</span>
				))
			}
		</span>
	</div>
	<nav aria-label="main navigation">
		<div class="primary-links">
			<MainNavItem href="/" label="home" japanese="ホーム" />
			<MainNavItem href="/me" label="me" japanese="わたし" />
			<MainNavItem href="/blog" label="blog" japanese="ブログ" />
			<MainNavItem href="/pix" label="pix" japanese="画像" />
			<MainNavItem href="/tweets" label="tweets" japanese="つぶやき" />
			<details class="nav-dropdown">
				<MainNavItem as="summary" label="nonsense" japanese="ばかなこと" active={isNonsenseActive} />
				<div class="nav-dropdown__items">
					<MainNavItem href="/nonsense/bash-org" label="bash.org quote picker" japanese="ばかなこと１" />
				</div>
			</details>
		</div>
		<div class="nav-actions">
			<WalkerSelector />
			<LoginButton isLoggedIn={isLoggedIn} />
		</div>
	</nav>
	<!-- Keeps site-wide extras with the navigation rather than inside the content card. -->
	<Footer />
</div>

<script>
	import { bindPage } from '../scripts/bind-page';

	// Keeps the transparent navigation cutout aligned with the scrolling logo bubble.
	bindPage('.site-logo__bubble', (bubble) => {
		const layout = bubble.closest<HTMLElement>('.site-layout');
		const header = bubble.closest<HTMLElement>('.site-header');
		if (!layout || !header) return;

		const controller = new AbortController();
		let animationFrame = 0;
		let transitionFrame = 0;
		let isTransitioning = false;
		const syncCutout = () => {
			const bounds = bubble.getBoundingClientRect();
			const borderWidth = Number.parseFloat(getComputedStyle(bubble).borderLeftWidth);
			const renderedScale = bounds.width / bubble.offsetWidth;
			const cutoutInset = (borderWidth + 4) * renderedScale;
			const cutoutRadius = Math.max(0, bounds.width / 2 - cutoutInset);
			layout.style.setProperty('--site-logo-cutout-x', `${bounds.left + bounds.width / 2}px`);
			layout.style.setProperty('--site-logo-cutout-y', `${bounds.top + bounds.height / 2}px`);
			layout.style.setProperty('--site-logo-cutout-radius', `${cutoutRadius}px`);
			layout.dataset.logoCutout = '';
		};
		const scheduleSync = () => {
			cancelAnimationFrame(animationFrame);
			animationFrame = requestAnimationFrame(syncCutout);
		};
		const syncTransition = () => {
			syncCutout();
			if (isTransitioning) transitionFrame = requestAnimationFrame(syncTransition);
		};
		const startTransitionSync = (event: TransitionEvent) => {
			if (event.propertyName !== 'transform') return;
			isTransitioning = true;
			cancelAnimationFrame(transitionFrame);
			transitionFrame = requestAnimationFrame(syncTransition);
		};
		const stopTransitionSync = (event: TransitionEvent) => {
			if (event.propertyName !== 'transform') return;
			isTransitioning = false;
			cancelAnimationFrame(transitionFrame);
			scheduleSync();
		};
		const observer = new ResizeObserver(scheduleSync);
		observer.observe(bubble);
		header.addEventListener('scroll', scheduleSync, { passive: true, signal: controller.signal });
		window.addEventListener('resize', scheduleSync, { passive: true, signal: controller.signal });
		bubble.addEventListener('transitionrun', startTransitionSync, { signal: controller.signal });
		bubble.addEventListener('transitionend', stopTransitionSync, { signal: controller.signal });
		bubble.addEventListener('transitioncancel', stopTransitionSync, { signal: controller.signal });
		bubble.addEventListener('pointerenter', scheduleSync, { signal: controller.signal });
		bubble.addEventListener('pointerleave', scheduleSync, { signal: controller.signal });
		syncCutout();

		return () => {
			cancelAnimationFrame(animationFrame);
			cancelAnimationFrame(transitionFrame);
			observer.disconnect();
			controller.abort();
		};
	});
</script>
