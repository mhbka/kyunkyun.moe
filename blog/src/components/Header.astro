---
import HeaderLink from './HeaderLink.astro';
import LoginButton from './LoginButton.astro';
import ThemeSelector from './ThemeSelector.astro';
import SideContent from './ui/SideContent.astro';

interface Props {
	isLoggedIn?: boolean;
}

const { isLoggedIn = false } = Astro.props;
---

<SideContent as="header" class="site-header">
	<nav>
		<div class="primary-links">
			<HeaderLink href="/">home</HeaderLink>
			<HeaderLink href="/me">me</HeaderLink>
			<HeaderLink href="/blog">blog</HeaderLink>
			<details class="nav-dropdown">
				<summary>nonsense</summary>
				<div class="nav-dropdown__items">
					<HeaderLink href="/nonsense/bash-org">bash.org quote picker</HeaderLink>
					<HeaderLink href="/nonsense/pix">pix</HeaderLink>
					<HeaderLink href="/nonsense/tweets">tweets</HeaderLink>
				</div>
			</details>
		</div>
		<div class="nav-actions">
			<ThemeSelector />
			<LoginButton isLoggedIn={isLoggedIn} />
		</div>
	</nav>
</SideContent>
<style>
	nav {
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 1.5rem;
	}
	nav a {
		padding: 0.25em 0;
		color: var(--color-heading);
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		font-weight: inherit;
	}
	nav a:hover {
		font-weight: 700;
	}
	.primary-links,
	.nav-actions {
		display: grid;
		gap: 0.75rem;
	}
	.nav-dropdown summary {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		list-style: none;
		white-space: nowrap;
		cursor: pointer;
		color: var(--color-heading);
	}
	.nav-dropdown summary::-webkit-details-marker { display: none; }
	.nav-dropdown summary::after {
		content: '▸';
		display: inline-block;
		font-size: 0.8em;
		transition: transform 120ms ease;
	}
	.nav-dropdown[open] summary::after { transform: rotate(90deg); }
	.nav-dropdown__items {
		display: grid;
		gap: 0.75rem;
		margin-top: 0.75rem;
		padding-left: 1rem;
	}
	@media (max-width: 800px) {
		nav { display: grid; gap: 0.75rem; }
		.primary-links,
		.nav-actions {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			justify-content: center;
			gap: 0.5rem 0.75rem;
		}
		.primary-links :global(a) { padding: 0.5rem 0.25rem; }
		.nav-dropdown { position: relative; }
		.nav-dropdown__items {
			position: absolute;
			z-index: 1;
			left: 50%;
			width: max-content;
			max-width: calc(100vw - 2rem);
			box-sizing: border-box;
			padding: 0.75rem;
			margin-top: 0.5rem;
			background: var(--color-surface);
			box-shadow: var(--shadow-header);
			transform: translateX(-50%);
		}
	}
</style>
