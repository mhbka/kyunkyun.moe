---
import { WALKERS } from '../consts';
import Select from './ui/Select.astro';
---

<Select fullWidth data-walker-selector aria-label="Walker">
	{WALKERS.map((walker) => <option value={walker.id}>{walker.label}</option>)}
</Select>


<script>
	import { DEFAULT_WALKER_ID, WALKERS } from '../consts';

	const walkerStorageKey = 'site-walker';

	import { bindPage } from '../scripts/bind-page';

	// Binds each newly rendered selector to the surviving walker through `walkerchange`.
	bindPage<HTMLSelectElement>('[data-walker-selector]', (walkerSelector) => {
		const savedWalker = localStorage.getItem(walkerStorageKey);
		const savedWalkerId = savedWalker === 'sweep' ? 'sweep_tosho' : savedWalker;
		const activeWalker = WALKERS.find((walker) => walker.id === savedWalkerId)?.id ?? DEFAULT_WALKER_ID;
		walkerSelector.value = activeWalker;
		walkerSelector.addEventListener('change', () => {
			localStorage.setItem(walkerStorageKey, walkerSelector.value);
			window.dispatchEvent(new CustomEvent('walkerchange', { detail: walkerSelector.value }));
		});
	});
</script>
