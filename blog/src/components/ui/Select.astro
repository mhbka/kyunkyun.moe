---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'select'> {
	fullWidth?: boolean;
}

const { class: className, fullWidth = false, ...props } = Astro.props;
---

<select class:list={['ui-select', { 'ui-select--full-width': fullWidth }, className]} {...props}>
	<slot />
</select>
