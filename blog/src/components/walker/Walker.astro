---
import { WALKERS } from '../../consts';
---

<img
	class="walker"
	src={WALKERS[0].standSrc}
	alt=""
	aria-hidden="true"
	transition:persist="walker"
/>


<script>
	import { DEFAULT_WALKER_ID, WALKERS } from '../../consts';
	import { onPointerMove } from '../../scripts/handlers/document-events';
	import { bindPage } from '../../scripts/bind-page';
	import { getWalkerImage } from './assets';
	import { moveTowardsCursor, shouldRestartWalking } from './movement';

	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const walkerStorageKey = 'site-walker';
	const savedWalker = localStorage.getItem(walkerStorageKey);
	const savedWalkerId = savedWalker === 'sweep' ? 'sweep_tosho' : savedWalker;
	const activeWalker = WALKERS.find((walker) => walker.id === savedWalkerId)?.id ?? DEFAULT_WALKER_ID;

	// Finds the image pair for the selected walker.
	function getWalker(id: string) {
		return WALKERS.find((walker) => walker.id === id) ?? WALKERS[0];
	}

	// Starts one walker's movement and interaction, returning its teardown.
	bindPage<HTMLImageElement>('.walker', (walker) => {
		let selectedWalker = getWalker(activeWalker);
		let position = window.innerWidth / 2;
		let target = position;
		let previousTime = 0;
		let animationFrame = 0;
		let isHovered = false;
		let isWalking = false;
		let walkingDirection: -1 | 1 = -1;
		let displayedSrc = '';

		// Updates the image only when its source changes.
		function showImage(src: string) {
			if (displayedSrc === src) return;

			displayedSrc = src;
			walker.src = src;
		}

		// Shows the image that matches the walker's current state.
		function showCurrentImage() {
			showImage(getWalkerImage(selectedWalker, isWalking, isHovered, walkingDirection));
		}

		showCurrentImage();

		// Switches between walking and standing images.
		function setWalking(walking: boolean, direction?: -1 | 1) {
			isWalking = walking;
			if (direction) walkingDirection = direction;
			showCurrentImage();
		}

		// Applies a newly selected walker without interrupting its movement.
		function selectWalker(id: string) {
			selectedWalker = getWalker(id);
			showCurrentImage();
		}

		// Updates the walker position once per paint while it follows the cursor.
		function walk(time: number) {
			const elapsedSeconds = Math.min((time - previousTime) / 1000, 0.1);
			previousTime = time;

			const step = moveTowardsCursor(position, target, elapsedSeconds);
			position = step.position;
			walker.style.setProperty('--walker-x', `${position}px`);

			if (step.direction === 0) {
				setWalking(false);
				animationFrame = 0;
				return;
			}

			setWalking(true, step.direction);
			animationFrame = requestAnimationFrame(walk);
		}

		// Sets the cursor X coordinate as the next destination.
		const handlePointerMove = (event: PointerEvent) => {
			target = event.clientX;

			if (!reducedMotion && animationFrame === 0 && shouldRestartWalking(position, target)) {
				previousTime = performance.now();
				animationFrame = requestAnimationFrame(walk);
			}
		};

		// Shows a character's pose while the pointer is over it.
		const onPointerEnter = () => {
			isHovered = true;
			showCurrentImage();
		};

		// Restores the standing or walking image after hover ends.
		const onPointerLeave = () => {
			isHovered = false;
			showCurrentImage();
		};

		const onWalkerChange = (event: Event) => {
			if (event instanceof CustomEvent && typeof event.detail === 'string') {
				selectWalker(event.detail);
			}
		};

		const stopPointerTracking = onPointerMove(handlePointerMove);
		walker.addEventListener('pointerenter', onPointerEnter);
		walker.addEventListener('pointerleave', onPointerLeave);
		window.addEventListener('walkerchange', onWalkerChange);

		// Releases listeners and the movement loop only when the walker is genuinely removed.
		return () => {
			cancelAnimationFrame(animationFrame);
			stopPointerTracking();
			walker.removeEventListener('pointerenter', onPointerEnter);
			walker.removeEventListener('pointerleave', onPointerLeave);
			window.removeEventListener('walkerchange', onWalkerChange);
		};
	});
</script>

<style>
	.walker {
		--walker-x: 50vw;
		position: fixed;
		bottom: 0;
		left: var(--walker-x);
		z-index: 10;
		width: min(12rem, 30vw);
		height: auto;
		pointer-events: auto;
		transform: translateX(-50%);
	}

	@media (max-width: 800px) {
		/* Keeps the cursor-following decoration off compact touch layouts. */
		.walker { display: none; }
	}
</style>
