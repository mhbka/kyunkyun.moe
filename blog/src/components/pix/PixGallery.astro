---
import type { Pix } from '../../lib/models/pix.ts';
import Button from '../ui/Button.astro';
import Select from '../ui/Select.astro';
import TagInput from '../TagInput.astro';
import FileDropzone from '../ui/FileDropzone.astro';

interface Props {
	images: Pix[];
	nextBefore: string | null;
	hasMore: boolean;
	tags: string[];
	isPix: boolean;
	accessToken?: string;
}

const { images, nextBefore, hasMore, tags, isPix, accessToken } = Astro.props;
---

<section class="moe-gallery" data-moe-gallery data-next-before={nextBefore ?? ''} data-has-more={hasMore ? 'true' : 'false'} data-tags={JSON.stringify(tags)} data-token={accessToken ?? ''} data-can-edit={isPix ? 'true' : 'false'}>
	{isPix && (
		<div class="moe-upload" data-moe-upload>
			<FileDropzone id="moe-image" name="images" accept="image/avif,image/gif,image/jpeg,image/png,image/webp" label="upload pix..." />
			<TagInput id="pix-tags" name="tags" label="tags" />
			<Button class="moe-select-toggle" type="button" data-moe-select-toggle aria-pressed="false">select images to modify</Button>
			<div class="moe-tag-editor" data-moe-tag-editor hidden>
				<span data-moe-selected-count></span>
				<Select data-moe-tag-operation aria-label="tag operation">
					<option value="remove">delete</option>
					<option value="add">add</option>
					<option value="overwrite">overwrite</option>
				</Select>
				<Button type="button" data-moe-tag-save>save</Button>
			</div>
			<p class="moe-status" data-moe-status role="status"></p>
		</div>
	)}
	<div class="moe-grid" data-moe-grid>
		{images.map((image) => (
			<Button class="moe-thumbnail" type="button" data-image-id={image.id} data-image-url={image.publicUrl} data-image-tags={JSON.stringify(image.tags)} data-image-created-at={image.createdAt} aria-label="view full image">
				<img src={image.publicUrl} alt="" loading="lazy" />
				<span class="moe-thumbnail__tick" aria-hidden="true">✓</span>
			</Button>
		))}
	</div>
	<Button class="moe-load-more" type="button" data-moe-load-more hidden={!hasMore}>load more</Button>
	<dialog class="moe-portal" data-moe-portal aria-label="full-size image">
		<div class="moe-portal__details">
			<Button class="moe-portal__close" type="button" data-moe-close>close</Button>
			<div class="moe-portal__info">
				<time data-moe-portal-created-at></time>
				<span data-moe-portal-tags></span>
			</div>
		</div>
		<img data-moe-portal-image alt="" />
	</dialog>
</section>

<script>
	import { initPixGallery } from './gallery.ts';

	const gallery = document.querySelector<HTMLElement>('[data-moe-gallery]');
	if (gallery) initPixGallery(gallery);
</script>

<style>
	.moe-gallery { display: grid; gap: 1rem; }
	.moe-upload { display: grid; gap: 0.5rem; }
	.moe-status { min-height: 1lh; margin: 0; }
	.moe-tag-editor { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
	.moe-tag-editor[hidden] { display: none; }
	.moe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, clamp(8rem, 7.5vw, 12rem)), 1fr)); gap: 0.75rem; }
	.moe-load-more[hidden] { display: none; }
	:global(.moe-thumbnail) { position: relative; display: block; width: 100%; aspect-ratio: 1; padding: 0; overflow: hidden; background: var(--color-subtle); }
	:global(.moe-thumbnail img) { display: block; width: 100%; height: 100%; border-radius: 0; object-fit: cover; }
	:global(.moe-thumbnail__tick) { position: absolute; top: 0.45rem; right: 0.45rem; display: none; width: 1.5rem; height: 1.5rem; place-content: center; border-radius: 50%; background: var(--color-success); color: var(--color-surface); font-weight: bold; }
	:global(.moe-thumbnail.is-selected .moe-thumbnail__tick) { display: grid; }
	.moe-portal { position: fixed; inset: 50% auto auto 50%; transform: translate(-50%, -50%); max-width: calc(100vw - 2rem); max-height: calc(100vh - 2rem); max-height: calc(100dvh - 2rem); padding: 0; border: 0; background: transparent; box-shadow: none; overflow: hidden; }
	.moe-portal::backdrop { background: var(--color-overlay); }
	.moe-portal img { display: block; max-width: calc(100vw - 2rem); max-height: calc(100vh - 2rem); max-height: calc(100dvh - 2rem); object-fit: contain; }
	.moe-portal__details { position: absolute; z-index: 1; top: 0.5rem; right: 0.5rem; display: grid; justify-items: end; gap: 0.35rem; max-width: calc(100% - 1rem); padding: 0.5rem; border-radius: var(--radius-control); background: rgb(74 54 39 / 80%); color: var(--color-heading); }
	.moe-portal__close { padding: 0.35rem 0.65rem; }
	.moe-portal__info { display: grid; justify-items: end; gap: 0.15rem; font-size: 0.8rem; text-align: right; }
	.moe-portal__info :empty { display: none; }
</style>
