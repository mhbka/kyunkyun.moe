---
import FrierenLarp from '../bg_overlays/FrierenLarp.astro';
import AmbientButterflies from './AmbientButterflies.astro';
import NanamiPendulum from './NanamiPendulum.astro';
import ScrollIndicator from './ScrollIndicator.astro';
---

<div
	class="site-background"
	aria-hidden="true"
	transition:persist="background"
>
	<!-- Keeps independently styled artwork in the persisted background subtree. -->
	<FrierenLarp />
</div>

<!-- Lets the butterflies emerge from beneath the navigation fade. -->
<AmbientButterflies />

<ScrollIndicator />

<!-- Renders the interactive decoration above page content. -->
<NanamiPendulum />
