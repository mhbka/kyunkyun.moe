---
import BaseHead from '../components/layout/BaseHead.astro';
import HomePreviews from '../components/home/HomePreviews.astro';
import Changelog from '../components/home/Changelog.astro';
import PageLayout from '../components/layout/PageLayout.astro';
import EdgeCard from '../components/ui/EdgeCard.astro';
import { blogApi } from '../lib/api/index.ts';
import { getPageAuth } from '../lib/auth/page-auth.ts';
import { renderMarkdown } from '../lib/content/markdown.ts';
import homeMarkdown from '../content/index.md?raw';
import '../styles/base/home-content.css';

const { isLoggedIn } = await getPageAuth(Astro.request, Astro.cookies);
const content = await renderMarkdown(homeMarkdown);
const [pixResult, postsResult, tweetsResult] = await Promise.allSettled([
	blogApi.listPix(4),
	blogApi.listPosts(1, 1),
	blogApi.listTweets(1),
]);
const images = pixResult.status === 'fulfilled' ? pixResult.value.images : [];
const post = postsResult.status === 'fulfilled' ? postsResult.value.posts[0] : undefined;
const tweet = tweetsResult.status === 'fulfilled' ? tweetsResult.value.tweets[0] : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"home"}  />
	</head>
	<body class="home-page">
		<PageLayout isLoggedIn={isLoggedIn} title="home">
			<div class="markdown-content" set:html={content} />
			<!-- Gives each homepage section its own reusable card beneath the introduction. -->
			<EdgeCard slot="cards" class="home-update-card" aria-label="latest updates">
				<HomePreviews images={images} post={post} tweet={tweet} />
			</EdgeCard>
			<EdgeCard slot="cards" class="home-update-card" aria-label="changelog">
				<Changelog />
			</EdgeCard>
		</PageLayout>
	</body>
</html>
