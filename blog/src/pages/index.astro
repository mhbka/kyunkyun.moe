---
import BaseHead from '../components/layout/BaseHead.astro';
import HomePreviews from '../components/home/HomePreviews.astro';
import PageLayout from '../components/layout/PageLayout.astro';
import EdgeCard from '../components/ui/EdgeCard.astro';
import { blogApi } from '../lib/api/index.ts';
import { getPageAuth } from '../lib/auth/page-auth.ts';
import '../styles/base/home-content.css';

const { isLoggedIn } = await getPageAuth(Astro.request, Astro.cookies);
const latest = await blogApi.getLatest().catch(() => undefined);
const images = latest?.pix ?? [];
const post = latest?.post ?? undefined;
const tweet = latest?.tweet ?? undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"home"}  />
	</head>
	<body class="home-page">
		<PageLayout isLoggedIn={isLoggedIn} title="home" separateCards>
			<!-- Gives each homepage section its own reusable card. -->
			<EdgeCard class="home-update-card" style="--home-card-offset: clamp(7rem, 25dvh, 17rem)" aria-label="latest updates">
				<HomePreviews images={images} post={post} tweet={tweet} />
			</EdgeCard>
		</PageLayout>
	</body>
</html>
