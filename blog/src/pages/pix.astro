---
import BaseHead from '../components/BaseHead.astro';
import FetchError from '../components/FetchError.astro';
import PixGallery from '../components/pix/PixGallery.astro';
import TagFilter from '../components/TagFilter.astro';
import PageLayout from '../components/PageLayout.astro';
import EdgeCard from '../components/ui/EdgeCard.astro';
import '../styles/base/pix-layout.css';
import { blogApi } from '../lib/api.ts';
import { getPageAuth } from '../lib/page-auth.ts';
import { readTagFilters } from '../lib/tags.ts';

const { isLoggedIn, isPix, accessToken } = await getPageAuth(Astro.request, Astro.cookies, { includePix: true });
const selectedTags = readTagFilters(Astro.url.searchParams);
const tags = await blogApi.listPixTags().catch(() => []);
let gallery;
let errorMessage: string | undefined;
try {
	gallery = await blogApi.listPix(60, undefined, selectedTags);
} catch (error) {
	console.warn(`Unable to load pix gallery: ${error}`);
	errorMessage = "couldn't load the gallery :(";
}
---

<!doctype html>
<html lang="en">
	<head><BaseHead title="pix" /></head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} title="pix" separateCards mainClass="pix-page">
			{
				errorMessage
				? <EdgeCard><FetchError message={errorMessage} /></EdgeCard>
				: <>
					<PixGallery
						images={gallery?.images ?? []}
						nextBefore={gallery?.nextBefore ?? null}
						hasMore={gallery?.hasMore ?? false} tags={selectedTags}
						isPix={isPix}
						accessToken={accessToken}
					>
						<div slot="filters">
							<h2 class="pix-tags-heading">tags:</h2>
							<TagFilter tags={tags} selectedTags={selectedTags} basePath="/pix/" />
						</div>
					</PixGallery>
				  </>
			}
		</PageLayout>
	</body>
</html>
