---
import BaseHead from '../../components/layout/BaseHead.astro';
import PageLayout from '../../components/layout/PageLayout.astro';
import FetchError from '../../components/FetchError.astro';
import Pagination from '../../components/layout/Pagination.astro';
import PostList from '../../components/posts/PostList.astro';
import TagFilter from '../../components/tags/TagFilter.astro';
import Link from '../../components/ui/Link.astro';
import EdgeCard from '../../components/ui/EdgeCard.astro';
import '../../styles/base/blog-listing.css';
import { blogApi } from '../../lib/api/index.ts';
import { fetchResult } from '../../lib/utils/fetch-result.ts';
import { getPageAuth } from '../../lib/auth/page-auth.ts';
import { parsePage } from '../../lib/utils/pagination.ts';
import { readTagFilters } from '../../lib/utils/tags.ts';

const pageSize = 20;
const page = parsePage(Astro.url.searchParams.get('page'));
const selectedTags = readTagFilters(Astro.url.searchParams);
const [result, tagsResult] = await Promise.all([
	fetchResult(
	() => blogApi.listPosts(page, pageSize, selectedTags),
	'We could not load the blog posts. Please try again shortly.',
),
	fetchResult(
	() => blogApi.listTags(),
	'We could not load the blog tags. Please try again shortly.',
),
]);
const posts = result.data?.posts ?? [];
const hasNext = result.data?.hasMore ?? false;
const tags = tagsResult.data ?? [];

const { isLoggedIn, isAuthor } = await getPageAuth(Astro.request, Astro.cookies, { includeAuthor: true });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"blog"}  />
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} title="blog" separateCards mainClass="blog-listing">
			{isAuthor && (
				<EdgeCard aria-labelledby="blog-author-heading">
					<h2 id="blog-author-heading" class="card-heading">author buttons:</h2>
					<div class="action-group">
						<Link class="ui-button" href="/posts/new/">create post</Link>
						<Link class="ui-button" href="/blog/drafts/">view drafts</Link>
					</div>
				</EdgeCard>
			)}
			{result.error ? (
				<EdgeCard><FetchError message={result.error} /></EdgeCard>
			) : (
				<>
					<EdgeCard aria-labelledby="blog-tags-heading">
						<h2 id="blog-tags-heading" class="card-heading">tags:</h2>
						<TagFilter tags={tags} selectedTags={selectedTags} />
					</EdgeCard>
					<PostList posts={posts} variant="published" isAuthor={isAuthor} cards />
					<Pagination page={page} hasNext={hasNext} tags={selectedTags} />
				</>
			)}
		</PageLayout>
	</body>
</html>
