---
import BlogPost from '../../layouts/BlogPost.astro';
import { blogApi } from '../../lib/api/index.ts';
import { fetchResult } from '../../lib/utils/fetch-result.ts';
import { renderMarkdown } from '../../lib/content/markdown.ts';
import { getPageAuth } from '../../lib/auth/page-auth.ts';

const result = await fetchResult(
	() => blogApi.getPost(Astro.params.slug ?? ''),
	'We could not load this blog post. Please try again shortly.',
);
const post = result.data;
const content = post ? await renderMarkdown(post.contentMd, post.media) : undefined;
const publishedAt = post?.publishedAt ? new Date(post.publishedAt) : undefined;
const { isLoggedIn, isAuthor } = await getPageAuth(Astro.request, Astro.cookies, { includeAuthor: true });
---

<BlogPost
	title={post?.title ?? 'Blog post unavailable'}
	publishedAt={publishedAt}
	updatedAt={post ? new Date(post.updatedAt) : undefined}
	tags={post?.tags}
	thumbnailUrl={post?.thumbnailUrl}
	content={content}
	errorMessage={result.error}
	postId={post?.id}
	isLoggedIn={isLoggedIn}
	isAuthor={isAuthor}
/>
