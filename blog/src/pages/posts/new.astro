---
import BaseHead from '../../components/layout/BaseHead.astro';
import PageLayout from '../../components/layout/PageLayout.astro';
import PostEditor from '../../components/editor/PostEditor.astro';
import PostContents from '../../components/posts/PostContents.astro';
import { getPageAuth } from '../../lib/auth/page-auth.ts';

const { isLoggedIn, isAuthor } = await getPageAuth(Astro.request, Astro.cookies, { includeAuthor: true });
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={"create post"} />
	</head>
	<body>
		<PageLayout isLoggedIn={isLoggedIn} mainClass="post-page">
			<PostContents slot="left-sidebar" target="post-content" editable />
			{isAuthor ? <PostEditor /> : <p>You must be logged in with author access to create a post.</p>}
		</PageLayout>
	</body>
</html>
